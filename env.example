# Copy to .env (the operator normally provides a filled-in .env instead).
OFFSITE_HOSTNAME=offsite-backup
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Optional self-hosted control server URL (headscale); empty = Tailscale SaaS.
TS_LOGIN_SERVER=
CONFIG_ROOT=./config
DATA_PATH=/mnt/backups-offsite
PROM_PUSH_URL=http://bridge-node:9090/api/v1/metrics/write
LOKI_PUSH_URL=http://bridge-node:3100/loki/api/v1/push

# --- bandwidth cap (yours to set — protects YOUR network) ---
# Mbit/s; 0 = unlimited. Change and `docker compose restart shaper` to apply.
MAX_DOWN_MBIT=0
MAX_UP_MBIT=0
