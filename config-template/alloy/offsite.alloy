// Offsite telemetry → estate bridge node (SaaS tailnet) → observability.
// Push URLs come from the environment (they point at the estate-side bridge
// node's tailnet address).
//
// No docker socket, by design: the node ships ONLY its own logs, which the
// supervisor tees to /var/log/node.log. A guest container at someone else's
// house has no business seeing their other containers.

loki.source.file "self" {
  targets = [
    { "__path__" = "/var/log/node.log", "site" = "offsite", "stack" = "backups" },
  ]
  forward_to = [loki.write.estate.receiver]
}

prometheus.scrape "backup_stack" {
  // Everything runs in this container's netns — scrape over loopback.
  targets = [
    { "__address__" = "127.0.0.1:8000", "job" = "rest-server" },
    { "__address__" = "127.0.0.1:9002", "job" = "tailscaled" },
  ]
  forward_to = [prometheus.remote_write.estate.receiver]
}

// Outbound pushes must traverse the tailnet, and tailscaled runs in userspace
// mode (no TUN — it cannot capture plain outbound dials). tailscaled exposes
// an outbound HTTP proxy on 127.0.0.1:1055 for exactly this; it also resolves
// MagicDNS names, so the push URLs can use bare tailnet hostnames.
prometheus.remote_write "estate" {
  endpoint {
    url       = sys.env("PROM_PUSH_URL")
    proxy_url = "http://127.0.0.1:1055"
  }
  external_labels = { site = "offsite" }
  // Bound the buffer: if the bridge is unreachable, keep at most ~8h of
  // metrics. Never let a telemetry buffer eat someone's disk (or their
  // Unraid docker.img, if the state mount is missing).
  wal {
    truncate_frequency = "1h"
    max_keep_time      = "8h"
  }
}

loki.write "estate" {
  endpoint {
    url       = sys.env("LOKI_PUSH_URL")
    proxy_url = "http://127.0.0.1:1055"
  }
}
